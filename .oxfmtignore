# Files the formatter must not rewrite.
#
# src/brain/fonts.json is generated by scripts/build-brain.mjs. The formatter would reformat its JSON
# in a way the generator does not reproduce, so `pnpm run build:brain --check` would then report the
# committed file as stale on every CI run. Generated files belong to their generator alone.
src/brain/fonts.json

# AI tool instruction files are copies of AGENTS.md, regenerated by `pnpm run links`.
CLAUDE.md
.cursorrules
.windsurfrules
.github/copilot-instructions.md